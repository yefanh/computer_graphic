# Simple House - Correct normals for each vertex
# A house shape that works with the OBJ importer

# House body vertices (8 vertices for a box)
v -1.0  0.0  1.0
v  1.0  0.0  1.0
v  1.0  0.0 -1.0
v -1.0  0.0 -1.0
v -1.0  1.5  1.0
v  1.0  1.5  1.0
v  1.0  1.5 -1.0
v -1.0  1.5 -1.0

# Roof vertices (2 peak vertices)
v  0.0  2.5  1.0
v  0.0  2.5 -1.0

# Normals - one for each vertex (must match vertex count = 10)
vn -0.577 -0.577  0.577
vn  0.577 -0.577  0.577
vn  0.577 -0.577 -0.577
vn -0.577 -0.577 -0.577
vn -0.577  0.577  0.577
vn  0.577  0.577  0.577
vn  0.577  0.577 -0.577
vn -0.577  0.577 -0.577
vn  0.0  0.707  0.707
vn  0.0  0.707 -0.707

# Texture coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Faces - house body
# Bottom
f 1/1/1 4/2/4 3/3/3 2/4/2
# Front
f 1/1/1 2/2/2 6/3/6 5/4/5
# Back  
f 3/1/3 4/2/4 8/3/8 7/4/7
# Left
f 4/1/4 1/2/1 5/3/5 8/4/8
# Right
f 2/1/2 3/2/3 7/3/7 6/4/6

# Roof faces
# Front roof
f 5/1/5 6/2/6 9/3/9
# Back roof
f 8/1/8 7/2/7 10/3/10
# Left roof
f 5/1/5 9/2/9 10/3/10 8/4/8
# Right roof
f 6/1/6 7/2/7 10/3/10 9/4/9
